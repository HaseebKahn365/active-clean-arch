{
  "name": "active-ai-tools",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
    "test:emulator": "npm run build && firebase emulators:exec --only firestore \"node --test lib/test/**/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "uuid": "^11.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.3"
  }
}

